.idea
node_modules/
# Also ignore a worktree-root `node_modules` SYMLINK (the trailing-slash rule
# above matches directories, NOT a symlink to the main tree's node_modules).
/node_modules
dist/
.next/
.env
.env.local
.env.*.local
# Ignore all other dotenv variants (e.g. .env.production, .env.staging)…
.env.*
# …but keep example templates trackable, including nested ones.
!.env.example
!**/.env.example
*.log
.DS_Store
coverage/
artifacts/

.claude/*
# ...but DO track the bundled impeccable design skill.
!.claude/skills/
.claude/skills/*
!.claude/skills/impeccable/
CLAUDE.md
TARGET.md

.cert/*
storage/
# ...but NOT the source module that happens to be named "storage".
!packages/api/src/infrastructure/storage/
infrastructure/nginx.conf

# Local dev / test scripts that may contain secrets
scripts/*.local.mjs
scripts/*.local.js
packages/*/scripts/*.local.mjs
packages/*/scripts/*.local.js

# Build caches
*.tsbuildinfo

# Local reference checkouts
.refer/
.workbuddy/

# Verdaccio private-registry credentials (commit only the *.example files)
infra/verdaccio/.env
infra/verdaccio/htpasswd

# Declarative model-groups config (holds ${ENV} refs only, but keep real file
# out of git; commit only the .example template).
packages/api/config/model-groups.yaml
!packages/api/config/model-groups.yaml.example

# Content-storage backend registry may hold inline S3/R2/MinIO creds — keep the
# real file out of git; commit only the .example template.
packages/api/config/content-storage-backends.json
!packages/api/config/content-storage-backends.example.json

# Runtime-tuning overrides are per-deployment — keep the real file out of git;
# commit only the .example template.
packages/api/config/runtime-tuning.json
!packages/api/config/runtime-tuning.example.json
.worktrees/

# Python bytecode caches (mcp-plugins sidecars, scripts).
__pycache__/
*.pyc

# Vendored 小红书 (xhs) Go backend source: upstream xpzouying/xiaohongshu-mcp
# declares NO license (license:null) — committing its source is a redistribution
# risk — and the tree is ~81MB (mostly demo media). It is EXCLUDED from the repo.
# To build the xhs sidecar locally, clone the pinned SHA (see
# sidecars/xhs-mcp/UPSTREAM.md) into this path. The upstream license MUST be
# resolved before shipping xhs.
sidecars/xhs-mcp/vendor/xiaohongshu-mcp/

# Local working docs — relocated out of the published tree (see .docs).
.docs/
